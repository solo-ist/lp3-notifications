<?xml version="1.0" encoding="utf-8"?>
<!--
  allowBackup=false already disables cloud backup, but device-to-device
  transfer is governed separately. Exclude everything from both, explicitly,
  rather than relying on a default.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
